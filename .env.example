# ===========================================
# War Games - AI Provider Configuration
# ===========================================
# Copy this file to .env and fill in your API key(s).
# You need at least ONE provider key. Add more if you want different factions on different models.

# --- Global Default ---
# All factions use this provider unless overridden below.
AI_PROVIDER=gemini

# --- Per-Role Overrides (optional) ---
# Uncomment to give an AI faction, or the human command interpreter, a different AI brain.
# The faction the player picks is never sent to its own provider - only the interpreter is.
# NATO_AI_PROVIDER=anthropic
# RUSSIA_AI_PROVIDER=gemini
# CHINA_AI_PROVIDER=openai
# INTERPRETER_AI_PROVIDER=gemini

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI / ChatGPT ---
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_REASONING_EFFORT=none   # GPT-5+/o-series only; use "minimal" for older GPT-5 models
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic / Claude ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Event mode (Human vs AI) ---
# Turns per game (default 8). The game can still end earlier on a victory condition.
# MAX_TURNS=8
# Per-attempt model timeout in ms (default 15000) and retries for 429/5xx/network errors (default 2).
# AI_REQUEST_TIMEOUT_MS=15000
# AI_MAX_RETRIES=2

# --- Startup model check ---
# On boot the server asks each provider whether its model id exists (no tokens spent).
# Unknown model or rejected key = the server refuses to start; provider unreachable = warning only.
# SKIP_MODEL_CHECK=1
